  if (!all && r->id != r->cdt_sh_id) cd_dev_warn("state written without a setter: Pt.id");
  r->cdt_sh_id = r->id;
  if (!all && r->v != r->cdt_sh_v) cd_dev_warn("state written without a setter: Pt.v");
  r->cdt_sh_v = r->v;
}
static void cdt_dev_pre(W *S, int all) {
  (void)S; (void)all;
  if (!all && S->pings != S->cdt_sh_pings) cd_dev_warn("state written without a setter: W.pings");
  S->cdt_sh_pings = S->pings;
  if (!all && S->on != S->cdt_sh_on) cd_dev_warn("state written without a setter: W.on");
