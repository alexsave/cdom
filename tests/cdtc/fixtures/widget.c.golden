void page_init(void) {
  for (uint32_t i = 0; i < 21; i++) cdt_s[i] = cd_internz(cdt_lit[i]);
  cd_at(CD_DETACHED, 0); /* template 1: pt */
  cd_open(cdt_s[1]);
  cd_open(cdt_s[2]);
  cd_text(cdt_s[3]); cd_slot(0);
  cd_close();
  cd_open(cdt_s[4]);
  cd_text(cdt_s[3]); cd_slot(1);
  cd_close();
  cd_close();
  cd_tpl_save(1);
  cd_at(CD_DETACHED, 0); /* template 2: page, the then branch of {#if S->on} */
  cd_open(cdt_s[5]); cd_attr(cdt_s[6], cdt_s[7]);
  cd_close();
  cd_tpl_save(2);
}

void page_create(W *S) {
  page_view *cdt_v = &page_v;
  page_S = S;
  (void)S;
  cdt_full = 1; /* the first render takes the lists' keys and checks everything */
  cd_at(CD_MOUNT, 0);
  cdt_v->root = cd_id_new();
  cdt_v->top = cdt_v->root;
  cd_open(cdt_s[8]);
  cd_name(cdt_v->root);
  cdt_v->if6_root = 0;
  cd_open(cdt_s[9]);
  cd_class(cdt_s[10]);
  cdt_v->chart = cd_id_new();
  cd_open(cdt_s[11]);
  cd_name(cdt_v->chart);
  cd_attr(cdt_s[12], cdt_s[13]);
  cd_attr(cdt_s[14], cdt_s[15]);
  cd_close();
  cd_close();
  cdt_v->dial = cd_id_new();
  cd_open(cdt_s[16]);
  cd_listen_named(cdt_v->dial, cdt_s[17]); /* value-change */
  cd_listen(cdt_v->dial, CD_EV_CLICK);
  cd_listen_named(cdt_v->dial, cdt_s[18]); /* ready */
  cd_tag_set(cdt_v->dial, 2u << 24);
  cd_text(cdt_s[19]);
  cd_text_num(cdt_v->t5 = (uint32_t)(S->pings));
  cd_close();
  {
    uint32_t cdt_b = ((S->on) ? 1u : 0u);
    cdt_v->if6_b = cdt_b;
    if (cdt_b == 1) {
      cdt_v->if6_root = cd_id_new();
      cdt_v->maybe = cdt_v->if6_root;
      cd_open(cdt_s[5]);
      cd_name(cdt_v->if6_root);
      cd_attr(cdt_s[6], cdt_s[7]);
      cd_close();
    }
  }
  cdt_v->id8 = cd_id_new();
  cd_open(cdt_s[20]);
  cd_name(cdt_v->id8);
  page_list0.parent = cdt_v->id8;
  page_list0.owns_parent = 1;
  cd_close();
  cd_close();
}

void page_render(W *S) {
  page_view *cdt_v = &page_v;
  (void)S; (void)cdt_v;
  int cdt_all = cdt_full;
  cdt_full = 0;
#if CDOM_DEV
  cdt_dev_pre(S, cdt_all);
#endif
  if (cdt_all) {
    S->cdt_d[0] = 0xffffffffu;
  }
  uint32_t cdt_m[1];
  cdt_m[0] = S->cdt_d[0];
  S->cdt_d[0] = 0;
  if (cdt_m[0] & 0x1u) {
    uint32_t cdt_t = (uint32_t)(S->pings);
    CDT_CMP;
    if (cdt_t != cdt_v->t5) {
      cdt_v->t5 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_next(); cd_down(); cd_next(); cd_value_num(cdt_t);
    }
  }
  if (cdt_m[0] & 0x2u) {
    uint32_t cdt_b = ((S->on) ? 1u : 0u);
    CDT_CMP;
    if (cdt_b != cdt_v->if6_b) {
      if (cdt_v->if6_b) {
        cd_remove(cdt_v->if6_root);
        cdt_v->if6_root = 0;
      }
      cdt_v->if6_b = cdt_b;
      if (cdt_b == 1) { cd_at(cdt_v->root, cdt_v->id8); page_f7_create(S, cdt_v); }
    }
  }
  cdt_lw_pt[0] = cdt_all ? 0xffffffffu : 0u;
  /* {#each S->pts} */
  if ((cdt_m[0] & 0x4u) || cdt_kd_Pt) {
    uint32_t cdt_n = S->pts_n;
    if (cdt_n > page_kcap0) {
      page_kcap0 = cdt_n * 2;
      page_keys0 = cd_realloc(page_keys0, page_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) page_keys0[cdt_i] = page_key0(S, &S->pts[cdt_i]);
    page_fns0.ctx = S;
    cd_list_update(&page_list0, page_keys0, cdt_n, &page_fns0);
  } else if (cdt_qn_Pt > CDT_QCAP || cdt_lw_pt[0]) {
    for (uint32_t cdt_i = 0; cdt_i < page_list0.n; cdt_i++) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
  } else {
    for (uint32_t cdt_k = 0; cdt_k < cdt_qn_Pt; cdt_k++) { /* the queued items of this list */
      uintptr_t cdt_o = (uintptr_t)cdt_q_Pt[cdt_k] - (uintptr_t)S->pts;
      uint32_t cdt_i = (uint32_t)(cdt_o / sizeof(Pt));
      if (cdt_o < (uintptr_t)S->pts_n * sizeof(Pt) && cdt_i < page_list0.n) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
    }
  }
  cdt_qn_Pt = cdt_kd_Pt = 0;
  cdt_epoch++;
#if CDOM_DEV
  cdt_dev_post(S, cdt_all);
#endif
}

void page_dispatch(const cd_event_rec *e) {
  uint32_t cdt_t = cd_tag((cd_id)e->id);
  W *S = page_S;
  if (!S) return;
  switch (cdt_t >> 24) {
  case 1: { /* pt: <li> */
    Pt *p = page_find0(S, cdt_t & 0xffffffu);
    if (!p) return;
    switch (e->type) {
    case CD_EV_CUSTOM:
      if ((cd_str)e->key == cdt_s[0]) { /* sl-change */ pt_change(S, p, e); }
      break;
    default: break;
    }
    break;
  }
  case 2: { /* page: <x-dial> */
    switch (e->type) {
    case CD_EV_CLICK: dial_click(S, e); break;
    case CD_EV_CUSTOM:
      if ((cd_str)e->key == cdt_s[17]) { /* value-change */ dial(S, e); }
      if ((cd_str)e->key == cdt_s[18]) { /* ready */ dial_ready(S, e); }
      break;
    default: break;
    }
    break;
  }
  default: break;
  }
}
