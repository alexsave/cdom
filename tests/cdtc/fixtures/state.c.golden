uint32_t Model_save(const Model *s, uint8_t *dst, uint32_t cap) {
  uint64_t need = cdt_need_Model(s);
  if (need > 0xfffffffeu) return 0xffffffffu;
  if (need > cap) return (uint32_t)need;
  cdt_put_Model(dst, s);
  return (uint32_t)need;
}

int Model_load(Model *s, const uint8_t *src, uint32_t len) { /* one pass to check, one to fill */
  uint32_t o = 0;
  if (cdt_walk_Model(0, src, len, &o) || o != len) return -1;
  o = 0;
  if (cdt_walk_Model(s, src, len, &o)) return -1;
  cdt_full = 1; /* everything changed */
  return 0;
}

uint32_t cd_state_save(uint8_t *dst, uint32_t cap) { return Model_save(&model, dst, cap); }
int cd_state_load(const uint8_t *src, uint32_t len) { return Model_load(&model, src, len); }

/* ---- the page: page ---- */
page_view page_v;

#if CDOM_DEV
uint32_t page_dev_compares, page_dev_visits;
static void cdt_dev_pre(Model *S, int all) {
  (void)S; (void)all;
  if (!all && S->name != S->cdt_sh_name) cd_dev_warn("state written without a setter: Model.name");
  S->cdt_sh_name = S->name;
}
static void cdt_dev_post(Model *S, int all) {
  (void)S; (void)all;
}
#endif

void page_init(void) {
  for (uint32_t i = 0; i < 2; i++) cdt_s[i] = cd_internz(cdt_lit[i]);
}

void page_create(Model *M) {
  page_view *cdt_v = &page_v;
  (void)M;
  cdt_full = 1; /* the first render takes the lists' keys and checks everything */
  cd_at(CD_MOUNT, 0);
  cdt_v->root = cd_id_new();
  cd_open(cdt_s[0]);
  cd_name(cdt_v->root);
  cd_text(cdt_str(cdt_v->t1 = (M->name)));
  cd_close();
}

void page_render(Model *M) {
  page_view *cdt_v = &page_v;
  (void)M; (void)cdt_v;
  int cdt_all = cdt_full;
  cdt_full = 0;
#if CDOM_DEV
  cdt_dev_pre(M, cdt_all);
#endif
  if (cdt_all) {
    M->cdt_d[0] = 0xffffffffu;
  }
  uint32_t cdt_m[1];
  cdt_m[0] = M->cdt_d[0];
  M->cdt_d[0] = 0;
  if (cdt_m[0] & 0x1u) {
    cd_str cdt_t = (M->name);
    CDT_CMP;
    if (cdt_t != cdt_v->t1) {
      cdt_v->t1 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_value(cdt_str(cdt_t));
    }
  }
#if CDOM_DEV
  cdt_dev_post(M, cdt_all);
#endif
}

void page_dispatch(const cd_event_rec *e) {
  (void)e;
}
