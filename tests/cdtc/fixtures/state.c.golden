  for (uint32_t i = 0; i < r->people_n; i++) d = cdt_put_Person(d, &r->people[i]);
  d = cdt_put32(d, r->ids_n);
  for (uint32_t i = 0; i < r->ids_n; i++) d = cdt_put_Id(d, &r->ids[i]);
  return d;
}

static int cdt_walk_Model(Model *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->version = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 2) return -1;
  k = cdt_get16(b + *o);
  *o += 2;
  if (len - *o < k) return -1;
  if (r) r->name = cd_intern((const char *)b + *o, k);
  *o += k;
  if (len - *o < 4) return -1;
  if (r) r->flags = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 8) return -1;
  if (r) {
    Model_people_reserve(r, k);
    r->people_n = k;
  }
  for (uint32_t i = 0; i < k; i++)
    if (cdt_walk_Person(r ? &r->people[i] : 0, b, len, o)) return -1;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 4) return -1;
