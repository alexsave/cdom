void Sig_items_reserve(Sig *s, uint32_t n) {
  if (n <= s->items_cap) return;
  uint32_t c = s->items_cap ? s->items_cap : 16;
  while (c < n) c *= 2;
  s->items = cd_realloc(s->items, c * (uint32_t)sizeof(It));
  s->items_cap = c;
}

void Sig_items_mark(Sig *s) {
  s->cdt_d[0] |= 0x4u;
  s->cdt_d[1] |= 0x10000u;
#if CDOM_DEV
  CDT_OWN("Sig.items");
#endif
}

It *Sig_items_push(Sig *s) {
  if (s->items_n == s->items_cap) Sig_items_reserve(s, s->items_n + 1);
  It *r = &s->items[s->items_n++];
  *r = (It){0};
  Sig_items_mark(s);
  return r;
}

void Sig_items_remove(Sig *s, uint32_t i) {
  if (i >= s->items_n) return;
  for (uint32_t j = i + 1; j < s->items_n; j++) s->items[j - 1] = s->items[j];
  s->items_n--;
  Sig_items_mark(s);
}

void Sig_items_clear(Sig *s) {
  if (!s->items_n) return;
  s->items_n = 0;
  Sig_items_mark(s);
}

void Sig_items_swap(Sig *s, uint32_t i, uint32_t j) {
  if (i >= s->items_n || j >= s->items_n || i == j) return;
  It t = s->items[i];
  s->items[i] = s->items[j];
  s->items[j] = t;
  Sig_items_mark(s);
}

