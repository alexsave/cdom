  if (r) r->a17 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a18 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a19 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a20 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a21 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a22 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a23 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a24 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a25 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a26 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a27 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a28 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a29 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a30 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a31 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a32 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a33 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a34 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a35 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a36 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a37 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a38 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a39 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->x = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 2) return -1;
  k = cdt_get16(b + *o);
  *o += 2;
  if (len - *o < k) return -1;
  if (r) r->note = cd_intern((const char *)b + *o, k);
  *o += k;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 8) return -1;
  if (r) {
    Sig_items_reserve(r, k);
    r->items_n = k;
    for (uint32_t i = 0; i < k; i++) r->items[i] = (It){0};
  }
  for (uint32_t i = 0; i < k; i++)
    if (cdt_walk_It(r ? &r->items[i] : 0, b, len, o)) return -1;
  return 0;
}

static uint64_t cdt_need_It(const It *r) {
  uint64_t need = 8;
  (void)r;
  return need;
}

static uint8_t *cdt_put_It(uint8_t *d, const It *r) {
  (void)r;
  d = cdt_put32(d, r->id);
  d = cdt_put32(d, r->v);
  return d;
}

static int cdt_walk_It(It *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->id = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->v = cdt_get32(b + *o);
  *o += 4;
  return 0;
}

uint32_t Sig_save(const Sig *s, uint8_t *dst, uint32_t cap) {
  uint64_t need = cdt_need_Sig(s);
  if (need > 0xfffffffeu) return 0xffffffffu;
  if (need > cap) return (uint32_t)need;
  cdt_put_Sig(dst, s);
  return (uint32_t)need;
}

int Sig_load(Sig *s, const uint8_t *src, uint32_t len) { /* one pass to check, one to fill */
  uint32_t o = 0;
  if (cdt_walk_Sig(0, src, len, &o) || o != len) return -1;
  o = 0;
  if (cdt_walk_Sig(s, src, len, &o)) return -1;
  cdt_full = 1; /* everything changed */
  return 0;
}

uint32_t cd_state_save(uint8_t *dst, uint32_t cap) { return Sig_save(&G, dst, cap); }
int cd_state_load(const uint8_t *src, uint32_t len) { return Sig_load(&G, src, len); }

static uint32_t cdt_lw_it[1]; /* this render: it's bindings to redo for every item */
/* ---- template it: <li> per It ---- */
static it_view *it_views;
static uint32_t it_nviews, it_vcap, *it_vfree, it_nvfree;
static uint32_t it_view_new(void) {
  if (it_nvfree) return it_vfree[--it_nvfree];
  if (it_nviews == it_vcap) {
    it_vcap = it_vcap ? it_vcap * 2 : 1024;
    it_views = cd_realloc(it_views, it_vcap * (uint32_t)sizeof(it_view));
    it_vfree = cd_realloc(it_vfree, it_vcap * 4);
  }
  return it_nviews++;
}
static const char *const it_k0_s[2] = {"", "hot"};
static cd_str it_k0_c[2];

cd_id it_create(Sig *S, It *r, it_view *cdt_v) {
  (void)S; (void)r; (void)cdt_v;
  r->cdt_d[0] = 0;
#if CDOM_DEV
  r->cdt_sh_id = r->id;
  r->cdt_sh_v = r->v;
#endif
  cd_id cdt_root = cdt_v->root = cd_id_new();
  cd_tpl_text_num(1, 0, cdt_v->t1 = (uint32_t)(r->id));
  cd_tpl_text_num(1, 1, cdt_v->t3 = (uint32_t)(r->v));
  cd_clone(1);
  cd_name(cdt_root);
  cdt_v->c0 = (((r->v == S->x) ? 1u : 0u));
  if (cdt_v->c0) cd_class(cdt_cls(it_k0_c, it_k0_s, cdt_v->c0));
  cd_close();
  return cdt_root;
}

void it_patch(Sig *S, It *r, it_view *cdt_v, const uint32_t *cdt_m) {
  (void)S; (void)r; (void)cdt_v;
  (void)cdt_m;
  if (cdt_m[0] & 0x1u) {
    uint32_t cdt_c = (((r->v == S->x) ? 1u : 0u));
    CDT_CMP;
    if (cdt_c != cdt_v->c0) {
      cdt_v->c0 = cdt_c;
      cd_set_class(cdt_v->root, cdt_cls(it_k0_c, it_k0_s, cdt_c));
    }
  }
  if (cdt_m[0] & 0x2u) {
    uint32_t cdt_t = (uint32_t)(r->id);
    CDT_CMP;
    if (cdt_t != cdt_v->t1) {
      cdt_v->t1 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_value_num(cdt_t);
    }
  }
  if (cdt_m[0] & 0x4u) {
    uint32_t cdt_t = (uint32_t)(r->v);
    CDT_CMP;
    if (cdt_t != cdt_v->t3) {
      cdt_v->t3 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_next(); cd_next(); cd_value_num(cdt_t);
    }
  }
}

static void it_release(uint32_t cdt_vi) {
  it_view *cdt_v = &it_views[cdt_vi];
  (void)cdt_v;
  it_vfree[it_nvfree++] = cdt_vi;
}

/* ---- the page: page ---- */
page_view page_v;

/* {#each S->items as r (r->id)} <it/> */
static cd_list page_list0;
static uint32_t *page_keys0, page_kcap0;
static uint32_t page_key0(Sig *S, It *r) { (void)S; (void)r; return (uint32_t)(r->id); }
static cd_id page_ec0(void *cdt_ctx, uint32_t cdt_i, uint32_t *cdt_data) {
  Sig *S = cdt_ctx;
  uint32_t cdt_vi = it_view_new();
  it_view *cdt_v = &it_views[cdt_vi];
  cdt_v->key = page_keys0[cdt_i];
  cdt_v->idx = cdt_i;
  *cdt_data = cdt_vi;
  return it_create(S, &S->items[cdt_i], cdt_v);
}
static void page_ep0(void *cdt_ctx, uint32_t cdt_i, cd_item *cdt_it) {
  Sig *S = cdt_ctx;
  it_view *cdt_v = &it_views[cdt_it->data];
  cdt_v->idx = cdt_i;
  It *cdt_r = &S->items[cdt_i];
  uint32_t cdt_m[1];
  CDT_VISIT;
  cdt_m[0] = cdt_r->cdt_d[0] | cdt_lw_it[0];
  cdt_r->cdt_d[0] = 0;
  if (cdt_m[0]) it_patch(S, cdt_r, cdt_v, cdt_m);
}
static void page_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; it_release(cdt_it->data); }
static cd_list_fns page_fns0 = {0, page_ec0, page_ep0, page_ed0};

static void cdt_derive(Sig *S, int cdt_all) {
  if (cdt_all || (S->cdt_d[0] & 0x1u)) { /* total = S->a0 + S->a39 */
    uint32_t cdt_x = (uint32_t)(S->a0 + S->a39);
    if (cdt_x != S->total) {
      S->total = cdt_x;
      S->cdt_d[0] |= 0x2u;
      S->cdt_d[1] |= 0x1000u;
    }
  }
  if (cdt_all || (S->cdt_d[0] & 0x2u)) { /* twice = S->total * 2 */
    uint32_t cdt_x = (uint32_t)(S->total * 2);
    if (cdt_x != S->twice) {
      S->twice = cdt_x;
      S->cdt_d[1] |= 0x2000u;
    }
  }
  if (cdt_all || (S->cdt_d[0] & 0x4u)) { /* count = S->items_n */
    uint32_t cdt_x = (uint32_t)(S->items_n);
    if (cdt_x != S->count) {
      S->count = cdt_x;
      S->cdt_d[1] |= 0x4000u;
    }
  }
  if (cdt_all || (S->cdt_d[0] & 0x8u)) { /* shown = S->x ? S->note : 0 */
    cd_str cdt_x = (cd_str)(S->x ? S->note : 0);
    if (cdt_x != S->shown) {
      S->shown = cdt_x;
      S->cdt_d[1] |= 0x8000u;
    }
  }
}

