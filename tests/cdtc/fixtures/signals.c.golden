static uint8_t *cdt_put16(uint8_t *d, uint32_t v) { d[0] = (uint8_t)v; d[1] = (uint8_t)(v >> 8); return d + 2; }
static uint32_t cdt_get16(const uint8_t *s) { return s[0] | (uint32_t)s[1] << 8; }
static uint8_t *cdt_put32(uint8_t *d, uint32_t v) { return cdt_put16(cdt_put16(d, v), v >> 16); }
static uint32_t cdt_get32(const uint8_t *s) { return cdt_get16(s) | cdt_get16(s + 2) << 16; }
static uint32_t cdt_len(cd_str s) { uint32_t n = 0; if (s) cd_bytes(s, &n); return n; }
static uint8_t *cdt_putstr(uint8_t *d, cd_str s) {
  uint32_t n = cdt_len(s);
  const char *b = n ? cd_bytes(s, &n) : "";
  d = cdt_put16(d, n);
  for (uint32_t i = 0; i < n; i++) d[i] = (uint8_t)b[i];
  return d + n;
}

static uint64_t cdt_need_Sig(const Sig *r) {
  uint64_t need = 170;
  (void)r;
  {
    uint32_t k = cdt_len(r->note);
    if (k > 0xffff) return 0xffffffffffffffffull;
    need += k;
  }
  for (uint32_t i = 0; i < r->items_n; i++) {
    uint64_t k = cdt_need_It(&r->items[i]);
    if (k == 0xffffffffffffffffull) return k;
    need += k;
  }
  return need;
}

static uint8_t *cdt_put_Sig(uint8_t *d, const Sig *r) {
  (void)r;
  d = cdt_put32(d, r->a0);
  d = cdt_put32(d, r->a1);
  d = cdt_put32(d, r->a2);
  d = cdt_put32(d, r->a3);
  d = cdt_put32(d, r->a4);
