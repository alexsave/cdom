  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a11 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a12 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a13 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a14 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a15 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a16 = cdt_get32(b + *o);
  *o += 4;
