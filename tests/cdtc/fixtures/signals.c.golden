  d = cdt_put32(d, r->a11);
  d = cdt_put32(d, r->a12);
  d = cdt_put32(d, r->a13);
  d = cdt_put32(d, r->a14);
  d = cdt_put32(d, r->a15);
  d = cdt_put32(d, r->a16);
  d = cdt_put32(d, r->a17);
  d = cdt_put32(d, r->a18);
  d = cdt_put32(d, r->a19);
