static int cdt_walk_Sig(Sig *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->a0 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a1 = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  if (r) r->a2 = cdt_get32(b + *o);
