static int cdt_walk_Tag(Tag *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->id = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 2) return -1;
  k = cdt_get16(b + *o);
  *o += 2;
  if (len - *o < k) return -1;
  if (r) r->name = cd_intern((const char *)b + *o, k);
  *o += k;
  return 0;
}

uint32_t Board_save(const Board *s, uint8_t *dst, uint32_t cap) {
  uint64_t need = cdt_need_Board(s);
  if (need > 0xfffffffeu) return 0xffffffffu;
  if (need > cap) return (uint32_t)need;
  cdt_put_Board(dst, s);
  return (uint32_t)need;
}

int Board_load(Board *s, const uint8_t *src, uint32_t len) { /* one pass to check, one to fill */
  uint32_t o = 0;
  if (cdt_walk_Board(0, src, len, &o) || o != len) return -1;
  o = 0;
  if (cdt_walk_Board(s, src, len, &o)) return -1;
  cdt_full = 1; /* everything changed */
  return 0;
}

uint32_t cd_state_save(uint8_t *dst, uint32_t cap) { return Board_save(&B, dst, cap); }
int cd_state_load(const uint8_t *src, uint32_t len) { return Board_load(&B, src, len); }

