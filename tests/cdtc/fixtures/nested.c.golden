static int cdt_walk_Col(Col *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->id = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 2) return -1;
  k = cdt_get16(b + *o);
  *o += 2;
  if (len - *o < k) return -1;
  if (r) r->title = cd_intern((const char *)b + *o, k);
  *o += k;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 14) return -1;
  if (r) {
    for (uint32_t i = 0; i < r->cards_n; i++) cdt_drop_Card(&r->cards[i]);
    Col_cards_reserve(r, k);
    r->cards_n = k;
    for (uint32_t i = 0; i < k; i++) r->cards[i] = (Card){0};
