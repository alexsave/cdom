    col_vcap = col_vcap ? col_vcap * 2 : 1024;
    col_views = cd_realloc(col_views, col_vcap * (uint32_t)sizeof(col_view));
    col_vfree = cd_realloc(col_vfree, col_vcap * 4);
  }
  return col_nviews++;
}


/* {#each c->cards as k (k->id)} <card/> */
static struct { Board *S; Col *r; uint32_t pvi; } col_ctx0;
static uint32_t *col_keys0, col_kcap0;
static uint32_t col_key0(Board *S, Card *k) { (void)S; (void)k; return (uint32_t)(k->id); }
static cd_id col_ec0(void *cdt_ctx, uint32_t cdt_i, uint32_t *cdt_data) {
  (void)cdt_ctx;
  uint32_t cdt_vi = card_view_new();
  card_view *cdt_v = &card_views[cdt_vi];
  cdt_v->key = col_keys0[cdt_i];
  cdt_v->idx = cdt_i;
  cdt_v->pvi = col_ctx0.pvi;
  *cdt_data = cdt_vi;
  return card_create(col_ctx0.S, &col_ctx0.r->cards[cdt_i], cdt_v);
}
static void col_ep0(void *cdt_ctx, uint32_t cdt_i, cd_item *cdt_it) {
  (void)cdt_ctx;
  card_view *cdt_v = &card_views[cdt_it->data];
  cdt_v->idx = cdt_i;
  card_patch(col_ctx0.S, &col_ctx0.r->cards[cdt_i], cdt_v);
}
static void col_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; card_release(cdt_it->data); }
static cd_list_fns col_fns0 = {0, col_ec0, col_ep0, col_ed0};
static Card *col_find0(Board *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= card_nviews) return 0;
  card_view *cdt_v = &card_views[cdt_i];
  Col *cdt_p = page_find0(S, cdt_v->pvi);
  if (!cdt_p) return 0;
  if (cdt_v->idx < cdt_p->cards_n && col_key0(S, &cdt_p->cards[cdt_v->idx]) == cdt_v->key) return &cdt_p->cards[cdt_v->idx];
  for (uint32_t k = 0; k < cdt_p->cards_n; k++)
    if (col_key0(S, &cdt_p->cards[k]) == cdt_v->key) return &cdt_p->cards[k];
  return 0;
}
static void col_lists(Board *S, Col *c, col_view *cdt_v) {
  (void)S;
  {
    uint32_t cdt_n = c->cards_n;
    if (cdt_n > col_kcap0) {
      col_kcap0 = cdt_n * 2;
      col_keys0 = cd_realloc(col_keys0, col_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) col_keys0[cdt_i] = col_key0(S, &c->cards[cdt_i]);
    col_ctx0.S = S;
    col_ctx0.r = c;
    col_ctx0.pvi = (uint32_t)(cdt_v - col_views);
    cd_list_update(&cdt_v->list0, col_keys0, cdt_n, &col_fns0);
  }
}

static void col_f0_free(col_view *cdt_v) {
  cd_id_free(cdt_v->id1);
  cd_id_free(cdt_v->id6);
}

cd_id col_create(Board *S, Col *c, col_view *cdt_v) {
  (void)S; (void)c; (void)cdt_v;
  cd_id cdt_root = cdt_v->root = cd_id_new();
  cd_tpl_text(3, 0, cdt_str(cdt_v->t2 = (c->title)));
  cd_tpl_text_num(3, 1, cdt_v->t4 = (uint32_t)(c->cards_n));
  cd_clone(3);
  cd_name(cdt_root);
  cd_down();
  cdt_v->id1 = cd_id_new();
  cd_listen(cdt_v->id1, CD_EV_CLICK);
  cd_tag_set(cdt_v->id1, 3u << 24 | (uint32_t)(cdt_v - col_views));
  cd_next();
  cdt_v->id6 = cd_id_new();
  cd_name(cdt_v->id6);
  cd_close();
  cdt_v->list0 = (cd_list){0};
  cdt_v->list0.parent = cdt_v->id6;
  cdt_v->list0.owns_parent = 1;
  col_lists(S, c, cdt_v);
  return cdt_root;
}

void col_patch(Board *S, Col *c, col_view *cdt_v) {
  (void)S; (void)c; (void)cdt_v;
  {
    cd_str cdt_t = (c->title);
    if (cdt_t != cdt_v->t2) {
      cdt_v->t2 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_down(); cd_value(cdt_str(cdt_t));
    }
  }
  {
    uint32_t cdt_t = (uint32_t)(c->cards_n);
    if (cdt_t != cdt_v->t4) {
      cdt_v->t4 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_down(); cd_next(); cd_next(); cd_value_num(cdt_t);
    }
  }
  col_lists(S, c, cdt_v);
}

static void col_release(uint32_t cdt_vi) {
  col_view *cdt_v = &col_views[cdt_vi];
  (void)cdt_v;
  for (uint32_t i = 0; i < cdt_v->list0.n; i++) {
    cd_id_free(cdt_v->list0.items[i].node);
    card_release(cdt_v->list0.items[i].data);
  }
  cd_free(cdt_v->list0.items);
  cdt_v->list0 = (cd_list){0};
  col_f0_free(cdt_v);
  col_vfree[col_nvfree++] = cdt_vi;
}

/* ---- the page: page ---- */
page_view page_v;
static Board *page_S;

/* {#each S->cols as c (c->id)} <col/> */
static cd_list page_list0;
static uint32_t *page_keys0, page_kcap0;
static uint32_t page_key0(Board *S, Col *c) { (void)S; (void)c; return (uint32_t)(c->id); }
static cd_id page_ec0(void *cdt_ctx, uint32_t cdt_i, uint32_t *cdt_data) {
  Board *S = cdt_ctx;
  uint32_t cdt_vi = col_view_new();
  col_view *cdt_v = &col_views[cdt_vi];
  cdt_v->key = page_keys0[cdt_i];
  cdt_v->idx = cdt_i;
  *cdt_data = cdt_vi;
  return col_create(S, &S->cols[cdt_i], cdt_v);
}
static void page_ep0(void *cdt_ctx, uint32_t cdt_i, cd_item *cdt_it) {
  Board *S = cdt_ctx;
  col_view *cdt_v = &col_views[cdt_it->data];
  cdt_v->idx = cdt_i;
  col_patch(S, &S->cols[cdt_i], cdt_v);
}
static void page_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; col_release(cdt_it->data); }
static cd_list_fns page_fns0 = {0, page_ec0, page_ep0, page_ed0};
static Col *page_find0(Board *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= col_nviews) return 0;
  col_view *cdt_v = &col_views[cdt_i];
  if (cdt_v->idx < S->cols_n && page_key0(S, &S->cols[cdt_v->idx]) == cdt_v->key) return &S->cols[cdt_v->idx];
  for (uint32_t k = 0; k < S->cols_n; k++)
    if (page_key0(S, &S->cols[k]) == cdt_v->key) return &S->cols[k];
  return 0;
}

void page_init(void) {
  for (uint32_t i = 0; i < 17; i++) cdt_s[i] = cd_internz(cdt_lit[i]);
  cd_at(CD_DETACHED, 0); /* template 1: tag */
  cd_open(cdt_s[0]); cd_class(cdt_s[1]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_close();
  cd_tpl_save(1);
  cd_at(CD_DETACHED, 0); /* template 2: card */
  cd_open(cdt_s[3]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_open(cdt_s[4]);
  cd_close();
  cd_close();
  cd_tpl_save(2);
  cd_at(CD_DETACHED, 0); /* template 3: col */
  cd_open(cdt_s[5]);
  cd_open(cdt_s[6]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_text(cdt_s[7]);
  cd_text(cdt_s[2]); cd_slot(1);
  cd_text(cdt_s[8]);
  cd_close();
  cd_open(cdt_s[9]);
  cd_close();
  cd_close();
  cd_tpl_save(3);
  cd_at(CD_DETACHED, 0); /* template 4: card, the then branch of {#if k->done} */
  cd_open(cdt_s[10]);
  cd_text(cdt_s[11]);
  cd_close();
  cd_tpl_save(4);
}

void page_create(Board *S) {
  page_view *cdt_v = &page_v;
  page_S = S;
  (void)S;
  cd_at(CD_MOUNT, 0);
  cdt_v->root = cd_id_new();
  cd_open(cdt_s[12]);
  cd_name(cdt_v->root);
  cd_open(cdt_s[13]);
  cd_text(cdt_s[14]);
  cd_text_num(cdt_v->t3 = (uint32_t)(S->sel));
  cd_close();
  cdt_v->id4 = cd_id_new();
  cd_open(cdt_s[15]);
  cd_name(cdt_v->id4);
  page_list0.parent = cdt_v->id4;
  page_list0.owns_parent = 1;
  cd_close();
  cd_close();
}

void page_render(Board *S) {
  page_view *cdt_v = &page_v;
  (void)S; (void)cdt_v;
  {
    uint32_t cdt_t = (uint32_t)(S->sel);
    if (cdt_t != cdt_v->t3) {
      cdt_v->t3 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_down(); cd_next(); cd_value_num(cdt_t);
    }
  }
  {
    uint32_t cdt_n = S->cols_n;
    if (cdt_n > page_kcap0) {
      page_kcap0 = cdt_n * 2;
      page_keys0 = cd_realloc(page_keys0, page_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) page_keys0[cdt_i] = page_key0(S, &S->cols[cdt_i]);
    page_fns0.ctx = S;
    cd_list_update(&page_list0, page_keys0, cdt_n, &page_fns0);
  }
}

void page_dispatch(const cd_event_rec *e) {
  uint32_t cdt_t = cd_tag((cd_id)e->id);
  Board *S = page_S;
  if (!S) return;
  switch (cdt_t >> 24) {
  case 1: { /* tag: <span> */
    Tag *g = card_find0(S, cdt_t & 0xffffffu);
    if (!g) return;
    switch (e->type) {
    case CD_EV_CLICK: tag_click(S, g, e); break;
    default: break;
    }
    break;
  }
  case 2: { /* card: <li> */
    Card *k = col_find0(S, cdt_t & 0xffffffu);
    if (!k) return;
    switch (e->type) {
    case CD_EV_CLICK: card_click(S, k, e); break;
    default: break;
    }
    break;
  }
  case 3: { /* col: <h2> */
    Col *c = page_find0(S, cdt_t & 0xffffffu);
    if (!c) return;
    switch (e->type) {
    case CD_EV_CLICK: col_click(S, c, e); break;
    default: break;
    }
    break;
  }
  default: break;
  }
}
