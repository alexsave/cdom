  return d;
}

static int cdt_walk_Board(Board *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->sel = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 10) return -1;
  if (r) {
    for (uint32_t i = 0; i < r->cols_n; i++) cdt_drop_Col(&r->cols[i]);
    Board_cols_reserve(r, k);
    r->cols_n = k;
    for (uint32_t i = 0; i < k; i++) r->cols[i] = (Col){0};
  }
  for (uint32_t i = 0; i < k; i++)
    if (cdt_walk_Col(r ? &r->cols[i] : 0, b, len, o)) return -1;
  return 0;
}

