/* ---- template tag: <span> per Tag ---- */
static tag_view *tag_views;
static uint32_t tag_nviews, tag_vcap, *tag_vfree, tag_nvfree;
static uint32_t tag_view_new(void) {
  if (tag_nvfree) return tag_vfree[--tag_nvfree];
  if (tag_nviews == tag_vcap) {
    tag_vcap = tag_vcap ? tag_vcap * 2 : 1024;
    tag_views = cd_realloc(tag_views, tag_vcap * (uint32_t)sizeof(tag_view));
    tag_vfree = cd_realloc(tag_vfree, tag_vcap * 4);
  }
  return tag_nviews++;
}

cd_id tag_create(Board *S, Tag *g, tag_view *cdt_v) {
  (void)S; (void)g; (void)cdt_v;
  g->cdt_d[0] = 0;
#if CDOM_DEV
  g->cdt_sh_name = g->name;
#endif
  cd_id cdt_root = cdt_v->root = cd_id_new();
  cd_tpl_text(1, 0, cdt_str(cdt_v->t1 = (g->name)));
  cd_clone(1);
  cd_listen(cdt_root, CD_EV_CLICK);
  cd_tag_set(cdt_root, 1u << 24 | (uint32_t)(cdt_v - tag_views));
  cd_close();
  return cdt_root;
}

void tag_patch(Board *S, Tag *g, tag_view *cdt_v, const uint32_t *cdt_m) {
  (void)S; (void)g; (void)cdt_v;
  (void)cdt_m;
  if (cdt_m[0] & 0x1u) {
    cd_str cdt_t = (g->name);
    CDT_CMP;
    if (cdt_t != cdt_v->t1) {
      cdt_v->t1 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_value(cdt_str(cdt_t));
    }
  }
}

static void tag_release(uint32_t cdt_vi) {
  tag_view *cdt_v = &tag_views[cdt_vi];
  (void)cdt_v;
  tag_vfree[tag_nvfree++] = cdt_vi;
}

/* ---- template card: <li> per Card ---- */
static card_view *card_views;
static uint32_t card_nviews, card_vcap, *card_vfree, card_nvfree;
static uint32_t card_view_new(void) {
  if (card_nvfree) return card_vfree[--card_nvfree];
  if (card_nviews == card_vcap) {
    card_vcap = card_vcap ? card_vcap * 2 : 1024;
    card_views = cd_realloc(card_views, card_vcap * (uint32_t)sizeof(card_view));
    card_vfree = cd_realloc(card_vfree, card_vcap * 4);
  }
  return card_nviews++;
}
static const char *const card_k0_s[4] = {"", "done", "sel", "done sel"};
static cd_str card_k0_c[4];


/* {#each k->tags as g (g->id)} <tag/> */
static struct { Board *S; Card *r; uint32_t pvi; } card_ctx0;
static uint32_t *card_keys0, card_kcap0;
static uint32_t card_key0(Board *S, Tag *g) { (void)S; (void)g; return (uint32_t)(g->id); }
static cd_id card_ec0(void *cdt_ctx, uint32_t cdt_i, uint32_t *cdt_data) {
  (void)cdt_ctx;
  uint32_t cdt_vi = tag_view_new();
  tag_view *cdt_v = &tag_views[cdt_vi];
  cdt_v->key = card_keys0[cdt_i];
  cdt_v->idx = cdt_i;
  cdt_v->pvi = card_ctx0.pvi;
  *cdt_data = cdt_vi;
  return tag_create(card_ctx0.S, &card_ctx0.r->tags[cdt_i], cdt_v);
}
static void card_ep0(void *cdt_ctx, uint32_t cdt_i, cd_item *cdt_it) {
  (void)cdt_ctx;
  tag_view *cdt_v = &tag_views[cdt_it->data];
  cdt_v->idx = cdt_i;
  Tag *cdt_r = &card_ctx0.r->tags[cdt_i];
  uint32_t cdt_m[1];
  CDT_VISIT;
  cdt_m[0] = cdt_r->cdt_d[0] | cdt_lw_tag[0];
  cdt_r->cdt_d[0] = 0;
  if (cdt_m[0]) tag_patch(card_ctx0.S, cdt_r, cdt_v, cdt_m);
}
static void card_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; tag_release(cdt_it->data); }
static cd_list_fns card_fns0 = {0, card_ec0, card_ep0, card_ed0};
static Tag *card_find0(Board *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= tag_nviews) return 0;
  tag_view *cdt_v = &tag_views[cdt_i];
  Card *cdt_p = col_find0(S, cdt_v->pvi);
  if (!cdt_p) return 0;
  if (cdt_v->idx < cdt_p->tags_n && card_key0(S, &cdt_p->tags[cdt_v->idx]) == cdt_v->key) return &cdt_p->tags[cdt_v->idx];
  for (uint32_t k = 0; k < cdt_p->tags_n; k++)
    if (card_key0(S, &cdt_p->tags[k]) == cdt_v->key) return &cdt_p->tags[k];
  return 0;
}
static void card_lists(Board *S, Card *k, card_view *cdt_v, const uint32_t *cdt_m) {
  (void)S;
  if (cdt_m[0] & 0x8u) { /* {#each k->tags}: a key, an item or the list changed */
    uint32_t cdt_n = k->tags_n;
    if (cdt_n > card_kcap0) {
      card_kcap0 = cdt_n * 2;
      card_keys0 = cd_realloc(card_keys0, card_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) card_keys0[cdt_i] = card_key0(S, &k->tags[cdt_i]);
    card_ctx0.S = S;
    card_ctx0.r = k;
    card_ctx0.pvi = (uint32_t)(cdt_v - card_views);
    cd_list_update(&cdt_v->list0, card_keys0, cdt_n, &card_fns0);
  }
}

static cd_id card_f3_create(Board *S, Card *k, card_view *cdt_v) {
  (void)S; (void)k; (void)cdt_v;
  cd_id cdt_root = cdt_v->if2_root = cd_id_new();
  cd_clone(4);
  cd_name(cdt_root);
  cd_close();
  return cdt_root;
}

static void card_f0_free(card_view *cdt_v) {
  if (cdt_v->if2_b == 1) { cd_id_free(cdt_v->if2_root); }
  cd_id_free(cdt_v->id5);
}

cd_id card_create(Board *S, Card *k, card_view *cdt_v) {
  (void)S; (void)k; (void)cdt_v;
  k->cdt_d[0] = 0;
#if CDOM_DEV
  k->cdt_sh_id = k->id;
  k->cdt_sh_text = k->text;
  k->cdt_sh_done = k->done;
#endif
  cd_id cdt_root = cdt_v->root = cd_id_new();
  cdt_v->if2_root = 0;
  cd_tpl_text(2, 0, cdt_str(cdt_v->t1 = (k->text)));
  cd_clone(2);
  cd_listen(cdt_root, CD_EV_CLICK);
  cd_tag_set(cdt_root, 2u << 24 | (uint32_t)(cdt_v - card_views));
  cdt_v->c0 = (((k->done) ? 1u : 0u) | ((k->id == S->sel) ? 2u : 0u));
  if (cdt_v->c0) cd_class(cdt_cls(card_k0_c, card_k0_s, cdt_v->c0));
  cd_down(); cd_next();
  cdt_v->id5 = cd_id_new();
  cd_name(cdt_v->id5);
  cd_close();
  {
    uint32_t cdt_b = ((k->done) ? 1u : 0u);
    cdt_v->if2_b = cdt_b;
    if (cdt_b == 1) { cd_at(cdt_v->root, cdt_v->id5); card_f3_create(S, k, cdt_v); }
  }
  cdt_v->list0 = (cd_list){0};
  cdt_v->list0.parent = cdt_v->id5;
  cdt_v->list0.owns_parent = 1;
  card_lists(S, k, cdt_v, cdt_ones);
  return cdt_root;
}

void card_patch(Board *S, Card *k, card_view *cdt_v, const uint32_t *cdt_m) {
  (void)S; (void)k; (void)cdt_v;
  (void)cdt_m;
  if (cdt_m[0] & 0x1u) {
    uint32_t cdt_c = (((k->done) ? 1u : 0u) | ((k->id == S->sel) ? 2u : 0u));
    CDT_CMP;
    if (cdt_c != cdt_v->c0) {
      cdt_v->c0 = cdt_c;
      cd_set_class(cdt_v->root, cdt_cls(card_k0_c, card_k0_s, cdt_c));
    }
  }
  if (cdt_m[0] & 0x2u) {
    cd_str cdt_t = (k->text);
    CDT_CMP;
    if (cdt_t != cdt_v->t1) {
      cdt_v->t1 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_value(cdt_str(cdt_t));
    }
  }
  if (cdt_m[0] & 0x4u) {
    uint32_t cdt_b = ((k->done) ? 1u : 0u);
    CDT_CMP;
    if (cdt_b != cdt_v->if2_b) {
      if (cdt_v->if2_b) {
        cd_remove(cdt_v->if2_root);
        cdt_v->if2_root = 0;
      }
      cdt_v->if2_b = cdt_b;
      if (cdt_b == 1) { cd_at(cdt_v->root, cdt_v->id5); card_f3_create(S, k, cdt_v); }
    }
  }
  card_lists(S, k, cdt_v, cdt_m);
}

static void card_release(uint32_t cdt_vi) {
  card_view *cdt_v = &card_views[cdt_vi];
  (void)cdt_v;
  for (uint32_t i = 0; i < cdt_v->list0.n; i++) {
    cd_id_free(cdt_v->list0.items[i].node);
    tag_release(cdt_v->list0.items[i].data);
  }
  cd_free(cdt_v->list0.items);
  cdt_v->list0 = (cd_list){0};
  card_f0_free(cdt_v);
  card_vfree[card_nvfree++] = cdt_vi;
}

