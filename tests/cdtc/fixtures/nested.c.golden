static int cdt_walk_Card(Card *r, const uint8_t *b, uint32_t len, uint32_t *o) {
  uint32_t k;
  (void)r; (void)b; (void)k;
  if (len - *o < 4) return -1;
  if (r) r->id = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 2) return -1;
  k = cdt_get16(b + *o);
  *o += 2;
  if (len - *o < k) return -1;
  if (r) r->text = cd_intern((const char *)b + *o, k);
  *o += k;
  if (len - *o < 4) return -1;
  if (r) r->done = cdt_get32(b + *o);
  *o += 4;
  if (len - *o < 4) return -1;
  k = cdt_get32(b + *o);
  *o += 4;
  if (k > (len - *o) / 6) return -1;
  if (r) {
    Card_tags_reserve(r, k);
    r->tags_n = k;
    for (uint32_t i = 0; i < k; i++) r->tags[i] = (Tag){0};
  }
  for (uint32_t i = 0; i < k; i++)
    if (cdt_walk_Tag(r ? &r->tags[i] : 0, b, len, o)) return -1;
  return 0;
}

