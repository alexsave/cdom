/* ---- the page: page ---- */
page_view page_v;
static Board *page_S;

/* {#each S->cols as c (c->id)} <col/> */
static cd_list page_list0;
static uint32_t *page_keys0, page_kcap0;
static uint32_t page_key0(Board *S, Col *c) { (void)S; (void)c; return (uint32_t)(c->id); }
static cd_id page_ec0(void *cdt_ctx, uint32_t cdt_i, uint32_t *cdt_data) {
  Board *S = cdt_ctx;
  uint32_t cdt_vi = col_view_new();
  col_view *cdt_v = &col_views[cdt_vi];
  cdt_v->key = page_keys0[cdt_i];
  cdt_v->idx = cdt_i;
  *cdt_data = cdt_vi;
  return col_create(S, &S->cols[cdt_i], cdt_v);
}
static void page_ep0(void *cdt_ctx, uint32_t cdt_i, cd_item *cdt_it) {
  Board *S = cdt_ctx;
  col_view *cdt_v = &col_views[cdt_it->data];
  cdt_v->idx = cdt_i;
  Col *cdt_r = &S->cols[cdt_i];
  uint32_t cdt_m[1];
  CDT_VISIT;
  cdt_m[0] = cdt_r->cdt_d[0] | cdt_lw_col[0];
  cdt_r->cdt_d[0] = 0;
  if (cdt_m[0]) col_patch(S, cdt_r, cdt_v, cdt_m);
}
static void page_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; col_release(cdt_it->data); }
static cd_list_fns page_fns0 = {0, page_ec0, page_ep0, page_ed0};
static Col *page_find0(Board *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= col_nviews) return 0;
  col_view *cdt_v = &col_views[cdt_i];
  if (cdt_v->idx < S->cols_n && page_key0(S, &S->cols[cdt_v->idx]) == cdt_v->key) return &S->cols[cdt_v->idx];
  for (uint32_t k = 0; k < S->cols_n; k++)
    if (page_key0(S, &S->cols[k]) == cdt_v->key) return &S->cols[k];
  return 0;
}

#if CDOM_DEV
uint32_t page_dev_compares, page_dev_visits;
static void cdt_dev_Col(Col *r, int all);
static void cdt_dev_Card(Card *r, int all);
static void cdt_dev_Tag(Tag *r, int all);
static void cdt_dev_Col(Col *r, int all) {
  (void)r; (void)all;
  if (!all && r->title != r->cdt_sh_title) cd_dev_warn("state written without a setter: Col.title");
  r->cdt_sh_title = r->title;
  for (uint32_t i = 0; i < r->cards_n; i++) cdt_dev_Card(&r->cards[i], all);
}
static void cdt_dev_Card(Card *r, int all) {
  (void)r; (void)all;
  if (!all && r->id != r->cdt_sh_id) cd_dev_warn("state written without a setter: Card.id");
  r->cdt_sh_id = r->id;
  if (!all && r->text != r->cdt_sh_text) cd_dev_warn("state written without a setter: Card.text");
  r->cdt_sh_text = r->text;
  if (!all && r->done != r->cdt_sh_done) cd_dev_warn("state written without a setter: Card.done");
  r->cdt_sh_done = r->done;
  for (uint32_t i = 0; i < r->tags_n; i++) cdt_dev_Tag(&r->tags[i], all);
}
static void cdt_dev_Tag(Tag *r, int all) {
  (void)r; (void)all;
  if (!all && r->name != r->cdt_sh_name) cd_dev_warn("state written without a setter: Tag.name");
  r->cdt_sh_name = r->name;
}
static void cdt_dev_pre(Board *S, int all) {
  (void)S; (void)all;
  if (!all && S->sel != S->cdt_sh_sel) cd_dev_warn("state written without a setter: Board.sel");
  S->cdt_sh_sel = S->sel;
  if (!all && !(S->cdt_d[0] & 0x4u) && !cdt_kd_Col) {
    int bad = S->cols_n != page_list0.n;
    for (uint32_t i = 0; i < S->cols_n && !bad; i++) bad = page_key0(S, &S->cols[i]) != page_list0.items[i].key;
    if (bad) cd_dev_warn("list changed without a setter: Board.cols");
  }
}
static void cdt_dev_post(Board *S, int all) {
  (void)S; (void)all;
  for (uint32_t i = 0; i < S->cols_n; i++) cdt_dev_Col(&S->cols[i], all);
}
#endif

void page_init(void) {
  for (uint32_t i = 0; i < 17; i++) cdt_s[i] = cd_internz(cdt_lit[i]);
  cd_at(CD_DETACHED, 0); /* template 1: tag */
  cd_open(cdt_s[0]); cd_class(cdt_s[1]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_close();
  cd_tpl_save(1);
  cd_at(CD_DETACHED, 0); /* template 2: card */
  cd_open(cdt_s[3]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_open(cdt_s[4]);
  cd_close();
  cd_close();
  cd_tpl_save(2);
  cd_at(CD_DETACHED, 0); /* template 3: col */
  cd_open(cdt_s[5]);
  cd_open(cdt_s[6]);
  cd_text(cdt_s[2]); cd_slot(0);
  cd_text(cdt_s[7]);
  cd_text(cdt_s[2]); cd_slot(1);
  cd_text(cdt_s[8]);
  cd_close();
  cd_open(cdt_s[9]);
  cd_close();
  cd_close();
  cd_tpl_save(3);
  cd_at(CD_DETACHED, 0); /* template 4: card, the then branch of {#if k->done} */
  cd_open(cdt_s[10]);
  cd_text(cdt_s[11]);
  cd_close();
  cd_tpl_save(4);
}

void page_create(Board *S) {
  page_view *cdt_v = &page_v;
  page_S = S;
  (void)S;
  cdt_full = 1; /* the first render takes the lists' keys and checks everything */
  cd_at(CD_MOUNT, 0);
  cdt_v->root = cd_id_new();
  cd_open(cdt_s[12]);
  cd_name(cdt_v->root);
  cd_open(cdt_s[13]);
  cd_text(cdt_s[14]);
  cd_text_num(cdt_v->t3 = (uint32_t)(S->sel));
  cd_close();
  cdt_v->id4 = cd_id_new();
  cd_open(cdt_s[15]);
  cd_name(cdt_v->id4);
  page_list0.parent = cdt_v->id4;
  page_list0.owns_parent = 1;
  cd_close();
  cd_close();
}

void page_render(Board *S) {
  page_view *cdt_v = &page_v;
  (void)S; (void)cdt_v;
  int cdt_all = cdt_full;
  cdt_full = 0;
#if CDOM_DEV
  cdt_dev_pre(S, cdt_all);
#endif
  if (cdt_all) {
    S->cdt_d[0] = 0xffffffffu;
  }
  uint32_t cdt_m[1];
  cdt_m[0] = S->cdt_d[0];
  S->cdt_d[0] = 0;
  if (cdt_m[0] & 0x2u) {
    uint32_t cdt_t = (uint32_t)(S->sel);
    CDT_CMP;
    if (cdt_t != cdt_v->t3) {
      cdt_v->t3 = cdt_t;
      cd_sel(cdt_v->root); cd_down(); cd_down(); cd_next(); cd_value_num(cdt_t);
    }
  }
  cdt_lw_tag[0] = cdt_all ? 0xffffffffu : 0u;
  cdt_lw_card[0] = cdt_all ? 0xffffffffu : ((cdt_m[0] & 0x1u ? 0x1u : 0u));
  cdt_lw_col[0] = cdt_all ? 0xffffffffu : 0u;
  if (cdt_qn_Tag || cdt_kd_Tag || cdt_lw_tag[0]) cdt_lw_card[0] |= 0x8u; /* {#each k->tags} */
  if (cdt_qn_Card || cdt_kd_Card || cdt_lw_card[0]) cdt_lw_col[0] |= 0x4u; /* {#each c->cards} */
  /* {#each S->cols} */
  if ((cdt_m[0] & 0x4u) || cdt_kd_Col) {
    uint32_t cdt_n = S->cols_n;
    if (cdt_n > page_kcap0) {
      page_kcap0 = cdt_n * 2;
      page_keys0 = cd_realloc(page_keys0, page_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) page_keys0[cdt_i] = page_key0(S, &S->cols[cdt_i]);
    page_fns0.ctx = S;
    cd_list_update(&page_list0, page_keys0, cdt_n, &page_fns0);
  } else if (cdt_qn_Col > CDT_QCAP || cdt_lw_col[0]) {
    for (uint32_t cdt_i = 0; cdt_i < page_list0.n; cdt_i++) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
  } else {
    for (uint32_t cdt_k = 0; cdt_k < cdt_qn_Col; cdt_k++) { /* the queued items of this list */
      uintptr_t cdt_o = (uintptr_t)cdt_q_Col[cdt_k] - (uintptr_t)S->cols;
      uint32_t cdt_i = (uint32_t)(cdt_o / sizeof(Col));
      if (cdt_o < (uintptr_t)S->cols_n * sizeof(Col) && cdt_i < page_list0.n) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
    }
  }
  cdt_qn_Col = cdt_kd_Col = 0;
  cdt_qn_Card = cdt_kd_Card = 0;
  cdt_qn_Tag = cdt_kd_Tag = 0;
  cdt_epoch++;
#if CDOM_DEV
  cdt_dev_post(S, cdt_all);
#endif
}

void page_dispatch(const cd_event_rec *e) {
  uint32_t cdt_t = cd_tag((cd_id)e->id);
  Board *S = page_S;
  if (!S) return;
  switch (cdt_t >> 24) {
  case 1: { /* tag: <span> */
    Tag *g = card_find0(S, cdt_t & 0xffffffu);
    if (!g) return;
    switch (e->type) {
    case CD_EV_CLICK: tag_click(S, g, e); break;
    default: break;
    }
    break;
  }
  case 2: { /* card: <li> */
    Card *k = col_find0(S, cdt_t & 0xffffffu);
    if (!k) return;
    switch (e->type) {
    case CD_EV_CLICK: card_click(S, k, e); break;
    default: break;
    }
    break;
  }
  case 3: { /* col: <h2> */
    Col *c = page_find0(S, cdt_t & 0xffffffu);
    if (!c) return;
    switch (e->type) {
    case CD_EV_CLICK: col_click(S, c, e); break;
    default: break;
    }
    break;
  }
  default: break;
  }
}
