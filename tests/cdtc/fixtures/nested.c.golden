#endif
  cd_id cdt_root = cdt_v->root = cd_id_new();
  cd_tpl_text(3, 0, cdt_str(cdt_v->t2 = (c->title)));
  cd_tpl_text_num(3, 1, cdt_v->t4 = (uint32_t)(c->cards_n));
  cd_clone(3);
  cd_name(cdt_root);
  cd_down();
  cdt_v->id1 = cd_id_new();
