}
static void col_ed0(void *cdt_ctx, cd_item *cdt_it) { (void)cdt_ctx; card_release(cdt_it->data); }
static cd_list_fns col_fns0 = {0, col_ec0, col_ep0, col_ed0};
static Card *col_find0(Board *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= card_nviews) return 0;
  card_view *cdt_v = &card_views[cdt_i];
  Col *cdt_p = page_find0(S, cdt_v->pvi);
  if (!cdt_p) return 0;
  if (cdt_v->idx < cdt_p->cards_n && col_key0(S, &cdt_p->cards[cdt_v->idx]) == cdt_v->key) return &cdt_p->cards[cdt_v->idx];
  for (uint32_t k = 0; k < cdt_p->cards_n; k++)
    if (col_key0(S, &cdt_p->cards[k]) == cdt_v->key) return &cdt_p->cards[k];
  return 0;
}
static void col_lists(Board *S, Col *c, col_view *cdt_v, const uint32_t *cdt_m) {
  (void)S;
  if (cdt_m[0] & 0x4u) { /* {#each c->cards}: a key, an item or the list changed */
    uint32_t cdt_n = c->cards_n;
    if (cdt_n > col_kcap0) {
      col_kcap0 = cdt_n * 2;
      col_keys0 = cd_realloc(col_keys0, col_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) col_keys0[cdt_i] = col_key0(S, &c->cards[cdt_i]);
    col_ctx0.S = S;
    col_ctx0.r = c;
    col_ctx0.pvi = (uint32_t)(cdt_v - col_views);
