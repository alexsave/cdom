/* ---- state ---- */
typedef struct Pt { uint32_t id; uint32_t v;
  uint32_t cdt_d[1], cdt_q; /* cdtc's: dirty bits, and the render it is queued for */
#if CDOM_DEV /* what the last setter wrote */
  uint32_t cdt_sh_id; uint32_t cdt_sh_v;
#endif
