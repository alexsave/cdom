  uint32_t t4;
} pt_view;
cd_id pt_create(W *S, Pt *p, pt_view *cdt_v);
void pt_patch(W *S, Pt *p, pt_view *cdt_v, const uint32_t *cdt_m); /* redoes the bindings whose bits are set in cdt_m */
void page_init(void);              /* interns strings, builds every template */
void page_create(W *S);  /* builds the page under the mount; call once */
void page_render(W *S);  /* patches what setters marked since the last render */
void page_dispatch(const cd_event_rec *e); /* calls the handler an event names */
#if CDOM_DEV /* for tests: the bindings renders compared, the list items they looked at */
extern uint32_t page_dev_compares, page_dev_visits;
#endif
typedef struct page_view {
  cd_id root;
  cd_id top; /* ref */
  cd_id chart; /* ref */
  cd_id dial; /* ref */
  uint32_t t5;
  uint32_t if6_b;
  cd_id if6_root;
  cd_id maybe; /* ref */
  cd_id id8;
} page_view;
extern page_view page_v; /* the page's ids: ref="name" fields reach named nodes */

#endif
