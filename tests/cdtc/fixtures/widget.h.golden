typedef struct W {
  uint32_t pings;
  uint32_t on;
  Pt *pts;
  uint32_t pts_n, pts_cap;
  uint32_t cdt_d[1]; /* cdtc's dirty bits: the bindings the next render redoes */
#if CDOM_DEV /* what the last setter wrote */
  uint32_t cdt_sh_pings;
  uint32_t cdt_sh_on;
#endif
} W;
/* initial values; a str holds 0 until set, and 0 renders as "" */
#define W_INIT {0}
extern W G;

/* ---- signals: a render redoes only what was marked ----
 * Write a field through its setter, <Agg>_set_<field>(p, v): it stores v and, when v differs, marks
 * the bindings that read the field (a record also goes on its type's queue, so the render patches
 * only the records marked). After writing a field directly call <Agg>_mark_<field>(p); after
 * writing anything directly, W_mark_all(s) makes the next render redo everything once. A list
 * changes through _push, _remove, _clear and _swap, which mark it; after editing its array or count
 * by hand call <Owner>_<list>_mark. A record fresh from _push may be filled directly before the
 * next render, which creates it whole. A derived field is recomputed by the render when an input
 * was marked; it has no setter. A dev build (-DCDOM_DEV=1) reports, through cd_dev_warn, a field
 * the render finds changed without a setter, a list changed without a mark, and a component's
 * handler writing state it does not own. */
void W_mark_all(W *s);
void W_set_pings(W *s, uint32_t v);
void W_mark_pings(W *s);
void W_set_on(W *s, uint32_t v);
void W_mark_on(W *s);
void W_pts_reserve(W *s, uint32_t n);
Pt *W_pts_push(W *s); /* a zeroed record at the end: fill it directly before the next render */
void W_pts_remove(W *s, uint32_t i);
void W_pts_clear(W *s);
void W_pts_swap(W *s, uint32_t i, uint32_t j);
void W_pts_mark(W *s); /* after writing the array or its count directly */
void Pt_set_id(Pt *s, uint32_t v);
void Pt_mark_id(Pt *s);
void Pt_set_v(Pt *s, uint32_t v);
void Pt_mark_v(Pt *s);
/* the state as a fixed little-endian blob: fields in declaration order (derived ones left out), a
 * u32 as 4 bytes, a str as a u16 length then its bytes, a list as a u32 count then its records */
uint32_t W_save(const W *s, uint8_t *dst, uint32_t cap); /* bytes, or the need when > cap */
int W_load(W *s, const uint8_t *src, uint32_t len); /* 0 on success; s untouched on failure */

/* ---- handlers: the app defines these ---- */
void pt_change(W *S, Pt *p, const cd_event_rec *e);
void dial(W *S, const cd_event_rec *e);
void dial_click(W *S, const cd_event_rec *e);
void dial_ready(W *S, const cd_event_rec *e);

/* ---- templates ---- */
typedef struct pt_view {
  cd_id root;
  uint32_t key, idx; /* the item's key and its index at the last render */
