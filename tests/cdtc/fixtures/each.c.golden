uint32_t St_save(const St *s, uint8_t *dst, uint32_t cap) {
  uint64_t need = cdt_need_St(s);
  if (need > 0xfffffffeu) return 0xffffffffu;
  if (need > cap) return (uint32_t)need;
  cdt_put_St(dst, s);
  return (uint32_t)need;
}

int St_load(St *s, const uint8_t *src, uint32_t len) { /* one pass to check, one to fill */
  uint32_t o = 0;
  if (cdt_walk_St(0, src, len, &o) || o != len) return -1;
  o = 0;
  if (cdt_walk_St(s, src, len, &o)) return -1;
  cdt_full = 1; /* everything changed */
  return 0;
}

