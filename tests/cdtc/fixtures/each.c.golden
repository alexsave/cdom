    for (uint32_t i = 0; i < S->items_n && !bad; i++) bad = page_key0(S, &S->items[i]) != page_list0.items[i].key;
    if (bad) cd_dev_warn("list changed without a setter: St.items");
  }
  if (!all && !(S->cdt_d[0] & 0x2u) && !cdt_kd_Tag) {
    int bad = S->tags_n != page_list1.n;
    for (uint32_t i = 0; i < S->tags_n && !bad; i++) bad = page_key1(S, &S->tags[i]) != page_list1.items[i].key;
    if (bad) cd_dev_warn("list changed without a setter: St.tags");
  }
}
static void cdt_dev_post(St *S, int all) {
  (void)S; (void)all;
  for (uint32_t i = 0; i < S->items_n; i++) cdt_dev_Item(&S->items[i], all);
  for (uint32_t i = 0; i < S->tags_n; i++) cdt_dev_Tag(&S->tags[i], all);
}
#endif

void page_init(void) {
  for (uint32_t i = 0; i < 9; i++) cdt_s[i] = cd_internz(cdt_lit[i]);
  cd_at(CD_DETACHED, 0); /* template 1: item */
  cd_open(cdt_s[0]);
  cd_text(cdt_s[1]); cd_slot(0);
  cd_close();
  cd_tpl_save(1);
  cd_at(CD_DETACHED, 0); /* template 2: tag */
  cd_open(cdt_s[2]);
  cd_text(cdt_s[1]); cd_slot(0);
  cd_close();
  cd_tpl_save(2);
}

void page_create(St *S) {
  page_view *cdt_v = &page_v;
  page_S = S;
  (void)S;
  cdt_full = 1; /* the first render takes the lists' keys and checks everything */
  cd_at(CD_MOUNT, 0);
  cd_open(cdt_s[3]);
  cdt_v->id1 = cd_id_new();
  cd_open(cdt_s[4]);
  cd_name(cdt_v->id1);
  page_list0.parent = cdt_v->id1;
  page_list0.owns_parent = 1;
  cd_close();
  cdt_v->id3 = cd_id_new();
  cd_open(cdt_s[5]);
  cd_name(cdt_v->id3);
  cd_open(cdt_s[6]);
  cd_text(cdt_s[7]);
  cd_close();
  page_list1.parent = cdt_v->id3;
  page_list1.owns_parent = 0;
  cd_close();
  cd_close();
}

void page_render(St *S) {
  page_view *cdt_v = &page_v;
  (void)S; (void)cdt_v;
  int cdt_all = cdt_full;
  cdt_full = 0;
#if CDOM_DEV
  cdt_dev_pre(S, cdt_all);
#endif
  if (cdt_all) {
    S->cdt_d[0] = 0xffffffffu;
  }
  uint32_t cdt_m[1];
  cdt_m[0] = S->cdt_d[0];
  S->cdt_d[0] = 0;
  cdt_lw_item[0] = cdt_all ? 0xffffffffu : 0u;
  cdt_lw_tag[0] = cdt_all ? 0xffffffffu : 0u;
  /* {#each S->items} */
  if ((cdt_m[0] & 0x1u) || cdt_kd_Item) {
    uint32_t cdt_n = S->items_n;
    if (cdt_n > page_kcap0) {
      page_kcap0 = cdt_n * 2;
      page_keys0 = cd_realloc(page_keys0, page_kcap0 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) page_keys0[cdt_i] = page_key0(S, &S->items[cdt_i]);
    page_fns0.ctx = S;
    cd_list_update(&page_list0, page_keys0, cdt_n, &page_fns0);
  } else if (cdt_qn_Item > CDT_QCAP || cdt_lw_item[0]) {
    for (uint32_t cdt_i = 0; cdt_i < page_list0.n; cdt_i++) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
  } else {
    for (uint32_t cdt_k = 0; cdt_k < cdt_qn_Item; cdt_k++) { /* the queued items of this list */
      uintptr_t cdt_o = (uintptr_t)cdt_q_Item[cdt_k] - (uintptr_t)S->items;
      uint32_t cdt_i = (uint32_t)(cdt_o / sizeof(Item));
      if (cdt_o < (uintptr_t)S->items_n * sizeof(Item) && cdt_i < page_list0.n) page_ep0(S, cdt_i, &page_list0.items[cdt_i]);
    }
  }
  /* {#each S->tags} */
  if ((cdt_m[0] & 0x2u) || cdt_kd_Tag) {
    uint32_t cdt_n = S->tags_n;
    if (cdt_n > page_kcap1) {
      page_kcap1 = cdt_n * 2;
      page_keys1 = cd_realloc(page_keys1, page_kcap1 * 4);
    }
    for (uint32_t cdt_i = 0; cdt_i < cdt_n; cdt_i++) page_keys1[cdt_i] = page_key1(S, &S->tags[cdt_i]);
    page_fns1.ctx = S;
    cd_list_update(&page_list1, page_keys1, cdt_n, &page_fns1);
  } else if (cdt_qn_Tag > CDT_QCAP || cdt_lw_tag[0]) {
    for (uint32_t cdt_i = 0; cdt_i < page_list1.n; cdt_i++) page_ep1(S, cdt_i, &page_list1.items[cdt_i]);
  } else {
    for (uint32_t cdt_k = 0; cdt_k < cdt_qn_Tag; cdt_k++) { /* the queued items of this list */
      uintptr_t cdt_o = (uintptr_t)cdt_q_Tag[cdt_k] - (uintptr_t)S->tags;
      uint32_t cdt_i = (uint32_t)(cdt_o / sizeof(Tag));
      if (cdt_o < (uintptr_t)S->tags_n * sizeof(Tag) && cdt_i < page_list1.n) page_ep1(S, cdt_i, &page_list1.items[cdt_i]);
    }
  }
  cdt_qn_Item = cdt_kd_Item = 0;
  cdt_qn_Tag = cdt_kd_Tag = 0;
  cdt_epoch++;
#if CDOM_DEV
  cdt_dev_post(S, cdt_all);
#endif
}

void page_dispatch(const cd_event_rec *e) {
  uint32_t cdt_t = cd_tag((cd_id)e->id);
  St *S = page_S;
  if (!S) return;
  switch (cdt_t >> 24) {
  case 1: { /* item: <li> */
    Item *it = page_find0(S, cdt_t & 0xffffffu);
    if (!it) return;
    switch (e->type) {
    case CD_EV_CLICK: pick(S, it, e); break;
    default: break;
    }
    break;
  }
  default: break;
  }
}
