static Item *page_find0(St *S, uint32_t cdt_i) { /* the item a view shows */
  if (cdt_i >= item_nviews) return 0;
  item_view *cdt_v = &item_views[cdt_i];
  if (cdt_v->idx < S->items_n && page_key0(S, &S->items[cdt_v->idx]) == cdt_v->key) return &S->items[cdt_v->idx];
  for (uint32_t k = 0; k < S->items_n; k++)
    if (page_key0(S, &S->items[k]) == cdt_v->key) return &S->items[k];
  return 0;
}

