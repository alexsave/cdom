/* initial values; a str holds 0 until set, and 0 renders as "" */
#define St_INIT {0}

/* ---- signals: a render redoes only what was marked ----
 * Write a field through its setter, <Agg>_set_<field>(p, v): it stores v and, when v differs, marks
 * the bindings that read the field (a record also goes on its type's queue, so the render patches
 * only the records marked). After writing a field directly call <Agg>_mark_<field>(p); after
 * writing anything directly, St_mark_all(s) makes the next render redo everything once. A list
 * changes through _push, _remove, _clear and _swap, which mark it; after editing its array or count
 * by hand call <Owner>_<list>_mark. A record fresh from _push may be filled directly before the
 * next render, which creates it whole. A derived field is recomputed by the render when an input
 * was marked; it has no setter. A dev build (-DCDOM_DEV=1) reports, through cd_dev_warn, a field
 * the render finds changed without a setter, a list changed without a mark, and a component's
 * handler writing state it does not own. */
void St_mark_all(St *s);
void St_items_reserve(St *s, uint32_t n);
Item *St_items_push(St *s); /* a zeroed record at the end: fill it directly before the next render */
void St_items_remove(St *s, uint32_t i);
void St_items_clear(St *s);
void St_items_swap(St *s, uint32_t i, uint32_t j);
void St_items_mark(St *s); /* after writing the array or its count directly */
void St_tags_reserve(St *s, uint32_t n);
Tag *St_tags_push(St *s); /* a zeroed record at the end: fill it directly before the next render */
void St_tags_remove(St *s, uint32_t i);
void St_tags_clear(St *s);
void St_tags_swap(St *s, uint32_t i, uint32_t j);
void St_tags_mark(St *s); /* after writing the array or its count directly */
void Item_set_id(Item *s, uint32_t v);
void Item_mark_id(Item *s);
void Item_set_name(Item *s, cd_str v);
void Item_mark_name(Item *s);
void Tag_set_k(Tag *s, uint32_t v);
void Tag_mark_k(Tag *s);
void Tag_set_label(Tag *s, cd_str v);
void Tag_mark_label(Tag *s);
/* the state as a fixed little-endian blob: fields in declaration order (derived ones left out), a
 * u32 as 4 bytes, a str as a u16 length then its bytes, a list as a u32 count then its records */
uint32_t St_save(const St *s, uint8_t *dst, uint32_t cap); /* bytes, or the need when > cap */
int St_load(St *s, const uint8_t *src, uint32_t len); /* 0 on success; s untouched on failure */

/* ---- handlers: the app defines these ---- */
void pick(St *S, Item *it, const cd_event_rec *e);

