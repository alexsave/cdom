+/* Leaf bench (docs/leaf-bench.md): eight elements of one literal text per iteration, as the triplet and as one
+ * cd_leaf; with a class, as four calls and as one cd_leaf_class; with a runtime text; and one crossing alone. */
+EXPORT("trip8") void trip8(uint32_t n) {
+  for (uint32_t i = 0; i < n; i++) {
+    cd_open("td"); cd_text("Hello"); cd_close();
+    cd_open("span"); cd_text("div"); cd_close();
+    cd_open("a"); cd_text("col-md-1"); cd_close();
+    cd_open("p"); cd_text("glyphicon glyphicon-remove"); cd_close();
+    cd_open("h3"); cd_text("aria-hidden"); cd_close();
+    cd_open("em"); cd_text("Create 1,000 rows"); cd_close();
+    cd_open("b"); cd_text("danger"); cd_close();
+    cd_open("i"); cd_text("x"); cd_close();
+  }
+}
+EXPORT("leaf8") void leaf8(uint32_t n) {
+  for (uint32_t i = 0; i < n; i++) {
+    cd_leaf("td", "Hello");
+    cd_leaf("span", "div");
+    cd_leaf("a", "col-md-1");
+    cd_leaf("p", "glyphicon glyphicon-remove");
+    cd_leaf("h3", "aria-hidden");
+    cd_leaf("em", "Create 1,000 rows");
+    cd_leaf("b", "danger");
+    cd_leaf("i", "x");
+  }
+}
+EXPORT("quad8") void quad8(uint32_t n) {
+  for (uint32_t i = 0; i < n; i++) {
+    cd_open("td"); cd_class("c1"); cd_text("Hello"); cd_close();
+    cd_open("span"); cd_class("c2"); cd_text("div"); cd_close();
+    cd_open("a"); cd_class("c3"); cd_text("col-md-1"); cd_close();
+    cd_open("p"); cd_class("c4"); cd_text("glyphicon glyphicon-remove"); cd_close();
+    cd_open("h3"); cd_class("c5"); cd_text("aria-hidden"); cd_close();
+    cd_open("em"); cd_class("c6"); cd_text("Create 1,000 rows"); cd_close();
+    cd_open("b"); cd_class("c7"); cd_text("danger"); cd_close();
+    cd_open("i"); cd_class("c8"); cd_text("x"); cd_close();
+  }
+}
+EXPORT("leafc8") void leafc8(uint32_t n) {
+  for (uint32_t i = 0; i < n; i++) {
+    cd_leaf_class("td", "c1", "Hello");
+    cd_leaf_class("span", "c2", "div");
+    cd_leaf_class("a", "c3", "col-md-1");
+    cd_leaf_class("p", "c4", "glyphicon glyphicon-remove");
+    cd_leaf_class("h3", "c5", "aria-hidden");
+    cd_leaf_class("em", "c6", "Create 1,000 rows");
+    cd_leaf_class("b", "c7", "danger");
+    cd_leaf_class("i", "c8", "x");
+  }
+}
+EXPORT("triptmp") void triptmp(uint32_t n, uint32_t len) {
+  for (uint32_t i = 0; i < n; i++) { cd_open("a"); cd_text(cd_tmp(buf, len)); cd_close(); }
+}
+EXPORT("leaftmp") void leaftmp(uint32_t n, uint32_t len) {
+  for (uint32_t i = 0; i < n; i++) cd_leaf("a", cd_tmp(buf, len));
+}
+EXPORT("cross8") void cross8(uint32_t n) {
+  for (uint32_t i = 0; i < n; i++) {
+    cd_name_open(1); cd_name_open(2); cd_name_open(3); cd_name_open(4);
+    cd_name_open(5); cd_name_open(6); cd_name_open(7); cd_name_open(8);
+  }
+}
 EXPORT("dom_reset") void dom_reset(void) {
   cd_close();
   cd_flush();
