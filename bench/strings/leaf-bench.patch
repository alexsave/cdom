 sed 's/^\( *\)\(else \)\{0,1\}cd_tmp_ahead(arena + first, arena_len - first);/\1\2(void)first;/' "$here/cdom-keyed/src/app.c" > "$out/app-noahead.c"
 grep -q cd_tmp_ahead "$out/app-noahead.c" && { echo "app-noahead.c still calls cd_tmp_ahead" >&2; exit 1; }
diff --git a/bench/strings/leaf-jfb.sh b/bench/strings/leaf-jfb.sh
new file mode 100755
index 0000000..9187930
--- /dev/null
+++ b/bench/strings/leaf-jfb.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Leaf bench (docs/leaf-bench.md), the pages: create 1k (01_) and create 10k (07_) through tools/pair.sh,
+# 15 iterations, the entries of build-leaf.sh in ABBA order in pass 1 and the reverse in pass 2, against
+# the jfb server on 8093. Results in the PAIR checkout's results/pairs/leaf-p<k>; summaries here.
+set -u
+here="$(cd "$(dirname "$0")" && pwd)"
+pair="${PAIR:-/Users/alex/Dev/cdom-strings-bench/tools/pair.sh}"
+res="$(cd "$(dirname "$pair")/.." && pwd)/results/pairs"
+export PORT=8093
+order1="lf-tn lf-ln lf-ln2 lf-tn2 lf-t lf-l lf-l2 lf-t2"
+order2="lf-t2 lf-l2 lf-l lf-t lf-tn2 lf-ln2 lf-ln lf-tn"
+for k in ${PASSES:-1 2}; do
+  if [ $((k % 2)) = 1 ]; then o="$order1"; else o="$order2"; fi
+  TAG="leaf-p$k" FWS="$o" "$pair" 01_ 07_
+  { node "$here/jfbsum.mjs" "$res/leaf-p$k" lf-tn lf-tn2 lf-ln lf-ln2
+    node "$here/jfbsum.mjs" "$res/leaf-p$k" lf-t lf-t2 lf-l lf-l2; } > "$here/results/leaf-jfb-p$k.tsv"
+  cat "$here/results/leaf-jfb-p$k.tsv"
+done
diff --git a/bench/strings/leaf-micro.sh b/bench/strings/leaf-micro.sh
new file mode 100755
index 0000000..f7acce5
--- /dev/null
+++ b/bench/strings/leaf-micro.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+# Leaf bench micro (docs/leaf-bench.md): PASSES passes of micro-s.mjs's leaf rows, the order reversed
+# every other pass, one headless Chrome at a time; TSV per pass in results/leaf-micro-<k>.tsv.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+"$here/micro-s.sh"
+for k in $(seq 1 "${PASSES:-4}"); do
+  if [ $((k % 2)) = 0 ]; then rev=1; else rev=; fi
+  LEAF_REV=$rev node "$here/micro-s.mjs" 'test=(cross8|trip8|leaf8|quad8|leafc8|triptmp|leaftmp)' > "$here/results/leaf-micro-$k.tsv"
+  cat "$here/results/leaf-micro-$k.tsv"
+done
diff --git a/bench/strings/leaf-pages.sh b/bench/strings/leaf-pages.sh
new file mode 100755
index 0000000..5388510
--- /dev/null
+++ b/bench/strings/leaf-pages.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+# Leaf bench (docs/leaf-bench.md), startup and size: gen_synth.py's 2,000-site page in plain C as written
+# (synth-t, 250 triplets) and with its triplets as cd_leaf (synth-l), bundled as pages-s.sh bundles synth-s,
+# then startup.mjs over both, R loads each, in the two orders (results/leaf-startup-<k>.tsv).
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"; top="$here/../.."
+CC="${WASM_CC:-/opt/homebrew/opt/llvm/bin/clang}"
+. "$top/tools/cdomflags.sh"
+o="$here/out/pages"; mkdir -p "$o"
+python3 "$here/gen_synth.py" 2000 "$here/out/synth-lit.c"
+sed -E 's/CD_LIT\(("([^"\\]|\\.)*")\)/\1/g' "$here/out/synth-lit.c" > "$here/out/synth.c"
+sed -E 's/cd_open\(("[a-z0-9]+")\); cd_text\(([^;]*)\); cd_close\(\);/cd_leaf(\1, \2);/' "$here/out/synth.c" > "$here/out/synth-leaf.c"
+echo "leaves: $(grep -o 'cd_leaf(' "$here/out/synth-leaf.c" | wc -l | tr -d ' ')"
+for v in t l; do
+  src="$here/out/synth.c"; [ $v = l ] && src="$here/out/synth-leaf.c"
+  d="$o/synth-$v"; mkdir -p "$d"
+  "$CC" -Oz "${CDOM_CFLAGS[@]}" -Wall -Wextra -Werror "${CDOM_LDFLAGS[@]}" -Wl,--strip-all -o "$d/linked.wasm" \
+    "$src" "$top/src/cdom.c" "$top/src/mini.c"
+  "$CDOM_LITS" "$d/linked.wasm" "$d/app.wasm" "$d/app.wasm.lits"
+  base64 < "$d/app.wasm" | tr -d '\n\r' | CDOM_TITLE=synth awk -v shim="$top/shim/cdom.min.js" -v lits="$d/app.wasm.lits" \
+    -v wasm=bundle -v title=1 -f "$top/tools/page.awk" "$top/shim/page.html" > "$d/index.html"
+  rm "$d/linked.wasm"
+  printf 'synth-%s wasm %s B  page %s B  brotli %s B\n' "$v" "$(wc -c < "$d/app.wasm" | tr -d ' ')" \
+    "$(wc -c < "$d/index.html" | tr -d ' ')" "$(brotli -q 11 -c "$d/index.html" | wc -c | tr -d ' ')"
+done
+p=bench/strings/out/pages
+R="${R:-15}" node "$here/startup.mjs" st=$p/synth-t/index.html sl=$p/synth-l/index.html > "$here/results/leaf-startup-1.tsv"
+R="${R:-15}" node "$here/startup.mjs" sl=$p/synth-l/index.html st=$p/synth-t/index.html > "$here/results/leaf-startup-2.tsv"
+tail -n 4 "$here/results/leaf-startup-1.tsv" "$here/results/leaf-startup-2.tsv"
