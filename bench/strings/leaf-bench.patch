diff --git a/bench/strings/build-leaf.sh b/bench/strings/build-leaf.sh
new file mode 100755
index 0000000..82dce62
--- /dev/null
+++ b/bench/strings/build-leaf.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Leaf bench (docs/leaf-bench.md): the keyed app as committed (triplets) and a copy with its two
+# cd_open/cd_text/cd_close triplets written as cd_leaf, with and without templates, each built twice
+# (the second copy is the noise): lf-t lf-t2 lf-l lf-l2 (templates), lf-tn lf-tn2 lf-ln lf-ln2 (none).
+set -euo pipefail
+BUILD_LIB=1 . "$(cd "$(dirname "$0")" && pwd)/build-st.sh"
+out="$here/strings/out"; mkdir -p "$out"
+src="$here/cdom-keyed/src/app.c"
+sed -E 's/cd_open\(("[a-z0-9]+")\); cd_text\(([^;]*)\); cd_close\(\);/cd_leaf(\1, \2);/' "$src" > "$out/app-leaf.c"
+n="$(grep -c 'cd_leaf(' "$out/app-leaf.c")"
+[ "$n" = 2 ] || { echo "app-leaf.c has $n leaves, not 2" >&2; exit 1; }
+for k in "" 2; do
+  build "lf-t$k" "leaf bench, triplets, templates"
+  APP_SRC="$out/app-leaf.c" build "lf-l$k" "leaf bench, cd_leaf, templates"
+  build "lf-tn$k" "leaf bench, triplets, no templates" -DCDOM_TEMPLATES=0
+  APP_SRC="$out/app-leaf.c" build "lf-ln$k" "leaf bench, cd_leaf, no templates" -DCDOM_TEMPLATES=0
+done
